# Copie ce fichier en .env puis adapte les valeurs.

# IP locale de la TV (Paramètres > Général > Réseau > État du réseau)
TV_IP=192.168.18.49

# 8002 = wss + token (par défaut). 8001 = ws simple (TV 2016-2017).
# Le serveur essaie automatiquement l'autre port si celui-ci ne répond pas.
TV_PORT=8002

# Adresse MAC de la TV pour l'allumer depuis le téléphone (Wake-on-LAN).
# Active aussi sur la TV : Réseau > Paramètres experts > Allumer avec mobile.
TV_MAC=

# Port de l'interface web
FLASK_PORT=5000
FLASK_DEBUG=false
